---
interface Props {
  title: string;
  body: string;
  href: string;
  img_src: string;
  img_alt: string;
}

const { href, title, body, img_src, img_alt } = Astro.props;
---

<li class="link-card">
  <a href={href} target="_blank" rel="noopener noreferrer">
    <img src={img_src} alt={img_alt} />
    <h2>{title}</h2>
    <p>{body}</p>
  </a>
</li>

<style>
  .link-card {
    list-style: none;
    display: flex;
    margin: 0;
    width: 320px;
    min-height: 280px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    box-shadow: 0 4px 20px -2px var(--shadow-color);
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s;
  }
  .link-card > a {
    width: 100%;
    text-decoration: none;
    line-height: 1.5;
    padding: 2rem 1.5rem;
    border-radius: 11px;
    color: var(--text-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }
  p {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-muted);
  }
  img {
    height: 64px;
    width: 64px;
    margin-bottom: 1.5rem;
    object-fit: contain;
    transition: transform 0.3s;
  }
  .link-card:hover {
    transform: translateY(-6px);
    border-color: rgba(99, 102, 241, 0.4);
    box-shadow:
      0 12px 30px -4px rgba(99, 102, 241, 0.15),
      0 4px 12px -2px rgba(99, 102, 241, 0.15);
  }
  .link-card:hover h2 {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .link-card:hover img {
    transform: scale(1.1);
  }
  @media (prefers-color-scheme: dark) {
    img {
      filter: invert(1) brightness(2);
    }
  }
</style>
