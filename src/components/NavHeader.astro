---

---

<div class="nav-container">
  <div class="main-div">
    <a href="/" class="logo-link">
      <img
        class="profile-img"
        src="/headshot2_cropped_circle.webp"
        alt="Brendan Rae profile"
      />
      <h3>Brendan Rae</h3>
    </a>
    <nav class="desktop-nav">
      <a href="/">home</a>
      <a href="/about">about</a>
      <a href="/resume">resume</a>
      <a href="/blog">blog</a>
    </nav>
    <button class="hamburger" aria-label="Toggle menu">
      <div class="bar"></div>
    </button>
  </div>
</div>
<nav class="mobile-nav">
  <a href="/">home</a>
  <a href="/about">about</a>
  <a href="/resume">resume</a>
  <a href="/blog">blog</a>
</nav>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const html_body = document.body;
    const menu_btn = document.querySelector(".hamburger");
    const mobile_nav_drawer = document.querySelector(".mobile-nav");

    menu_btn?.addEventListener("click", () => {
      menu_btn?.classList.toggle("is-active");
      mobile_nav_drawer?.classList.toggle("is-active");
      html_body.classList.toggle("no-scroll");
    });

    // Close menu when a link is clicked
    const links = document.querySelectorAll(".mobile-nav a");
    links.forEach((link) => {
      link.addEventListener("click", () => {
        menu_btn?.classList.remove("is-active");
        mobile_nav_drawer?.classList.remove("is-active");
        html_body.classList.remove("no-scroll");
      });
    });
  });
</script>

<style>
  .nav-container {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    width: 100%;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--card-border);
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }
  @media (prefers-color-scheme: dark) {
    .nav-container {
      background-color: rgba(11, 15, 25, 0.75);
    }
  }
  @media (prefers-color-scheme: light) {
    .nav-container {
      background-color: rgba(248, 250, 252, 0.8);
    }
  }
  .main-div {
    margin: auto;
    padding: 0 1rem;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 75px;
    max-width: 1200px;
  }
  .logo-link {
    display: flex;
    flex-direction: row;
    align-items: center;
    text-decoration: none;
    color: var(--text-color);
    transition: transform 0.2s;
  }
  .logo-link:hover {
    transform: scale(1.02);
  }
  img {
    border-radius: 50%;
    height: 44px;
    width: 44px;
    margin-right: 0.75rem;
    border: 2px solid var(--card-border);
    transition: border-color 0.3s;
    object-fit: cover;
  }
  .logo-link:hover img {
    border-color: rgb(var(--accent));
  }
  h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  a {
    font-size: 1.05rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    color: var(--text-color);
    transition: color 0.2s;
  }
  .desktop-nav {
    display: flex;
    flex-direction: row;
    gap: 2rem;
  }
  .desktop-nav a {
    position: relative;
    padding: 0.25rem 0;
    text-transform: capitalize;
  }
  .desktop-nav a::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--accent-gradient);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease-in-out;
    border-radius: 2px;
  }
  .desktop-nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .desktop-nav a:hover {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hamburger {
    position: relative;
    display: block;
    height: 24px;
    width: 28px;
    cursor: pointer;
    appearance: none;
    background: none;
    border: none;
    outline: none;
    padding: 0;
  }
  .hamburger .bar,
  .hamburger:after,
  .hamburger:before {
    content: "";
    display: block;
    width: 100%;
    height: 3px;
    background-color: var(--text-color);
    margin: 4px 0px;
    transition:
      transform 0.3s,
      opacity 0.3s;
    border-radius: 2px;
  }
  .hamburger.is-active:before {
    transform: rotate(-45deg) translate(-5px, 5px);
  }
  .hamburger.is-active:after {
    transform: rotate(45deg) translate(-5px, -5px);
  }
  .hamburger.is-active .bar {
    opacity: 0;
  }
  .mobile-nav {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    position: fixed;
    top: 75px;
    left: 100%;
    width: 100%;
    height: calc(100vh - 75px);
    overflow: hidden;
    z-index: 98;
    padding-top: 3rem;
    transition: transform 0.4s cubic-bezier(0.77, 0.2, 0.05, 1);
    background: var(--background-color);
  }
  .mobile-nav.is-active {
    transform: translateX(-100%);
  }
  .mobile-nav > a {
    display: block;
    text-align: center;
    margin-bottom: 1.5rem;
    padding: 0.75rem 1.5rem;
    width: 50%;
    font-size: 1.25rem;
    font-weight: 600;
    text-transform: capitalize;
    border-radius: 8px;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .mobile-nav > a:hover {
    background-color: var(--secondary-accent);
    color: rgb(var(--accent));
  }

  @media only screen and (max-width: 700px) {
    .desktop-nav {
      display: none;
    }
  }
  @media only screen and (min-width: 701px) {
    .hamburger {
      display: none;
    }
    .mobile-nav {
      display: none;
    }
  }
</style>
