---
import MainLayout from "../layouts/MainLayout.astro";
import TechStack from "../components/TechStack.astro";
---

<MainLayout title="About me | Brendan Rae">
  <main>
    <div class="content-container">
      <div class="text-container">
        <h1>Hi, I'm <span class="text-gradient">Brendan Rae</span></h1>
        <p>
          I am a <b>Senior Software Engineer</b> specializing in full-stack development, cloud modernization, and team leadership. With over 5 years of enterprise experience, I focus on transitioning legacy systems into scalable microservices architectures and pioneering practical, team-wide AI adoption. Whether I'm collaborating with offshore engineering teams or developing cross-platform mobile apps, I build robust, user-centric systems engineered for modern performance.
        </p>
      </div>
      <div class="img-wrapper">
        <img
          src="/_DSC2478.webp"
          alt="Brendan Rae Profile"
          class="profile-img"
        />
      </div>
    </div>

    <div class="content-container centered">
      <div class="text-container centered">
        <h1>
          <span class="text-gradient">Technologies</span> I have experience with
        </h1>
        <div class="svg-container">
          <TechStack />
        </div>
      </div>
    </div>

    <div class="content-container reverse">
      <div class="img-wrapper">
        <img
          src="/acadia_vista_1.webp"
          alt="Brendan Rae at Acadia National Park"
          class="acadia-vista-img"
        />
      </div>
      <div class="text-container">
        <h1><span class="text-gradient">My life</span> outside of work</h1>
        <p>
          Outside of my professional career, I love to enjoy the outdoors. Being
          in nature is therapeutic for me, and I love to hike and camp all over
          the country, especially in our great National Parks. Check out my blog
          to see some of the adventures I've been on! I also love to play hockey
          and stay physically active as much as possible.
        </p>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  main {
    animation: fadeInAnimation ease-out 0.6s;
    padding: 3rem 1rem;
    margin: auto;
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }
  .content-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 3rem;
  }
  .content-container.reverse {
    flex-direction: row-reverse;
  }
  .img-wrapper {
    flex: 1;
    display: flex;
    justify-content: center;
  }
  .img-wrapper img {
    border-radius: 16px;
    border: 1px solid var(--card-border);
    box-shadow: 0 10px 30px -10px var(--shadow-color);
    max-width: 100%;
    height: auto;
    transition: transform 0.3s ease;
  }
  .img-wrapper img:hover {
    transform: scale(1.02);
  }
  .profile-img {
    max-height: 480px;
    object-fit: cover;
  }
  .acadia-vista-img {
    max-height: 400px;
    object-fit: cover;
  }
  .text-container {
    flex: 1.2;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .text-container > h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.03em;
  }
  .text-container > p {
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-weight: 300;
    line-height: 1.7;
    color: var(--text-muted);
    margin: 0;
  }
  .centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }
  .svg-container {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
    width: 100%;
  }

  @keyframes fadeInAnimation {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media only screen and (max-width: 850px) {
    main {
      gap: 4rem;
      padding: 2rem 1rem;
    }
    .content-container,
    .content-container.reverse {
      flex-direction: column;
      text-align: center;
      gap: 2rem;
    }
    .text-container {
      align-items: center;
    }
    .profile-img,
    .acadia-vista-img {
      max-height: 350px;
    }
  }
</style>
