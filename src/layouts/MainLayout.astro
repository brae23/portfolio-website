---
import NavHeader from "../components/NavHeader.astro";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Brendan Rae's portfolio website" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <header>
    <NavHeader />
  </header>
  <body>
    <slot />
  </body>

  <style is:global>
    :root {
      --accent: 99, 102, 241;
      --accent-light: 199, 210, 254;
      --accent-dark: 67, 56, 202;
      color-scheme: light dark;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --text-color: #f3f4f6;
        --text-muted: #9ca3af;
        --background-color: #0b0f19;
        --card-bg: rgba(30, 41, 59, 0.4);
        --card-border: rgba(255, 255, 255, 0.08);
        --accent-gradient: linear-gradient(
          135deg,
          #6366f1,
          #8b5cf6 50%,
          #ec4899
        );
        --secondary-accent: #1e293b;
        --shadow-color: rgba(0, 0, 0, 0.4);
      }
      html {
        background: #0b0f19;
        background-image: radial-gradient(
            at 0% 0%,
            rgba(99, 102, 241, 0.12) 0px,
            transparent 50%
          ),
          radial-gradient(
            at 100% 100%,
            rgba(236, 72, 153, 0.08) 0px,
            transparent 50%
          );
        background-attachment: fixed;
      }
    }
    @media (prefers-color-scheme: light) {
      :root {
        --text-color: #0f172a;
        --text-muted: #64748b;
        --background-color: #f8fafc;
        --card-bg: rgba(255, 255, 255, 0.7);
        --card-border: rgba(0, 0, 0, 0.06);
        --accent-gradient: linear-gradient(
          135deg,
          #4f46e5,
          #7c3aed 50%,
          #db2777
        );
        --secondary-accent: #f1f5f9;
        --shadow-color: rgba(0, 0, 0, 0.05);
      }
      html {
        background: #f8fafc;
        background-image: radial-gradient(
            at 0% 0%,
            rgba(99, 102, 241, 0.06) 0px,
            transparent 50%
          ),
          radial-gradient(
            at 100% 100%,
            rgba(236, 72, 153, 0.05) 0px,
            transparent 50%
          );
        background-attachment: fixed;
      }
    }
    html {
      font-family: "Inter", system-ui, sans-serif;
      scroll-behavior: smooth;
      color: var(--text-color);
    }
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      font-family: "Outfit", sans-serif;
    }
    body {
      margin: auto;
      width: 100%;
      max-width: 1200px;
      padding: 0 1.5rem;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
    }
    code {
      font-family:
        Menlo,
        Monaco,
        Lucida Console,
        Liberation Mono,
        DejaVu Sans Mono,
        Bitstream Vera Sans Mono,
        Courier New,
        monospace;
    }
    .text-gradient {
      background-image: var(--accent-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-size: 200% auto;
      background-clip: text;
    }
    .no-scroll {
      overflow: hidden;
    }
  </style>

</html>
